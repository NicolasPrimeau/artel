# Copy to .env — run `python scripts/seed_keys.py` to auto-generate AGENT_KEYS
# UI
UI_PASSWORD=changeme
UI_DEFAULT_THEME=gruvbox   # gruvbox | tokyo-night | nord | dracula | kanagawa | rose-pine | ...

# Server — format: agent-id:api-key, comma-separated. Optional third segment scopes to projects.
# The archivist and MCP containers derive their keys from this list automatically.
AGENT_KEYS=archivist:changeme,mcp:changeme

# Registration key — required to register new agents (leave blank to disable)
REGISTRATION_KEY=

# LLM for the archivist — optional. Without this, decay and promotion still run.
# Provider: anthropic (default) | openrouter | openai | claude-sdk
ARCHIVIST_PROVIDER=anthropic
ARCHIVIST_MODEL=                   # blank uses the provider default (claude-sonnet-4-6 / google/gemini-3.7-flash / gpt-4o)
ARCHIVIST_API_KEY=                 # falls back to the provider-specific key below
ARCHIVIST_BASE_URL=                # OpenAI-compatible base URL (Ollama, Mistral, etc.); openrouter sets its own
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...    # used when ARCHIVIST_PROVIDER=openrouter
