{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/artel-session-start.sh",
            "timeout": 12,
            "statusMessage": "Loading Artel session context\u2026"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/artel-recall.sh",
            "timeout": 5,
            "statusMessage": "Recalling relevant Artel memory\u2026"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/artel-pretool-gotcha.sh",
            "timeout": 5,
            "statusMessage": "Checking Artel notes for this file\u2026"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/artel-capture.sh",
            "timeout": 5,
            "statusMessage": "Capturing session before compaction\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/artel-capture.sh",
            "timeout": 5,
            "statusMessage": "Capturing session\u2026"
          }
        ]
      }
    ]
  }
}
